# Supabase project (Project Settings → API). The publishable key is safe in the browser;
# Row Level Security keeps each user's rows private.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The Telegram bot's username, without @ (Settings → Connect Telegram). Also a Cloudflare build variable.
VITE_TELEGRAM_BOT=your_bot

# Push reminders: the VAPID public key from `node scripts/vapid-keys.mjs <file>`. Also a Cloudflare build variable.
# The private key is the worker secret VAPID_PRIVATE_KEY. Without these, reminders come from the open app only.
VITE_VAPID_PUBLIC_KEY=
