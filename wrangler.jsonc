{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roadmap",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the Telegram webhook runs the worker; the app is served as static assets.
    "run_worker_first": ["/tg"],
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // The app gets VITE_* at build time (Cloudflare build variables); only the worker reads these.
  "vars": {
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_H8AJ7Aci8k0bMdfUAunhLQ_LnpMn8d8",
    "VITE_SUPABASE_URL": "https://sbdmiijoahyodmfnpqan.supabase.co",
  },
}
