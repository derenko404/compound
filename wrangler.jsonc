{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roadmap",
  "main": "worker/index.ts",
  // The app's address is compound.derenko.online. derenko.online and workers.dev keep working for links and installs made before.
  "routes": [
    { "pattern": "compound.derenko.online", "custom_domain": true },
    { "pattern": "derenko.online", "custom_domain": true },
  ],
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the Telegram webhook, AI access (API, MCP) and the push confirmation run the worker; the app is served as static assets.
    "run_worker_first": ["/tg", "/api/*", "/mcp", "/mcp/*", "/push/*"],
  },
  "ai": { "binding": "AI" },
  // Daily cleanup at 03:00 UTC (shared links older than 7 days, unused Telegram codes) and hourly push reminders (worker scheduled()).
  "triggers": { "crons": ["0 3 * * *", "0 * * * *"] },
  "observability": { "enabled": true },
  // The app gets VITE_* at build time (Cloudflare build variables); only the worker reads these.
  "vars": {
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_H8AJ7Aci8k0bMdfUAunhLQ_LnpMn8d8",
    "VITE_SUPABASE_URL": "https://sbdmiijoahyodmfnpqan.supabase.co",
    "VAPID_SUBJECT": "mailto:hello@derenko.online",
  },
}
